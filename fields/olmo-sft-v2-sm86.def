# Singularity/Apptainer definition for the Fields Model submission image.
#
# Bootstraps from the LOCAL docker image (chankhavu/olmo3-sft-v2:cu130-sm86) and bakes the real
# credentials (fields/SECRETS.json) into /app/SECRETS.json so the container needs no `-e` on the
# NII/ABCI Singularity cluster. The docker image itself is pushed WITHOUT secrets; the secrets live
# ONLY in this locally-built .sif — never push this .sif to a shared/public registry.
#
# Build (from repo root, so %files paths resolve):
#   bash fields/build_sif.sh            # robust: falls back past the bundled-mksquashfs bug
#   # or, if your apptainer's mksquashfs is healthy:
#   singularity build --fakeroot olmo3-fields_cu130.sif fields/olmo3-fields.def
# NOTE: apptainer/SingularityCE 1.5.1 bundles mksquashfs 4.7.5, which crashes on this ~12GB rootfs
# ("Bug in orderer"/SIGSEGV). build_sif.sh works around it via sandbox + system mksquashfs. See it.
#
# Run (defaults write under /tmp — bind it to a real host volume; --nv for GPUs):
#   singularity run --nv --containall \
#     --bind /scratch/$USER/training:/tmp \
#     olmo3-fields_cu130.sif --experiment olmo_7b_bf16 --max-tokens-per-rank 16384 --olmo-ac-budget 1.0
#
# ENV (FIELDS_WORKDIR=/tmp/olmo-sft/work, FIELDS_OUTPUT=/tmp/olmo-sft/output, HF_HOME=/tmp/olmo-sft/hf_cache)
# and the `python /app/train.py` entrypoint are inherited from the docker image — no %environment/%runscript
# override needed (omitting them preserves the docker-image values).

Bootstrap: docker-daemon
From: chankhavu/olmo3-sft-v2:cu130-sm86

%files
    # Bake real credentials into the .sif (HF_TOKEN + WANDB_API_KEY). secrets_loader reads
    # /app/SECRETS.json; a same-named env var still wins at runtime.
    fields/SECRETS.json /app/SECRETS.json

%runscript
    # Mirror the docker ENTRYPOINT explicitly so `singularity run <sif> <flags>` == train.py.
    exec python /app/train.py "$@"

%labels
    org.fields.entrypoint /app/train.py
    org.fields.base chankhavu/olmo3-sft-v2:cu130-sm86
    org.fields.secrets baked

%help
    Fields Model SFT image (Olmo-3 7B). Entrypoint: python /app/train.py.
    Bind a host dir to /tmp (defaults write there) and pass train.py flags after the .sif path.
    Convert checkpoints + upload with: singularity exec <sif> python /app/upload.py  (auto-runs after training)
