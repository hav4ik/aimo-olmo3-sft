############################################################################
# FULL local reproduction of NII run_01 — actual 1B training run
# olmo-sft-v2-allsm.sif on 2x RTX 3090, with a NON-executable nvcc bound in
# Command below is your 1B launch + one extra --bind for the broken nvcc.
############################################################################
+ singularity run --nv --containall \
    --bind /mnt/data/sif-test/tmp:/tmp \
    --bind /mnt/data/sif-test/fake/nvcc:/usr/local/bin/nvcc \
    --home $PWD:/home/guest --pwd /home/guest olmo-sft-v2-allsm.sif \
    --experiment olmo_1b_bf16 --seq-len 8192 --run-suffix nvccrepro \
    --max-steps 2000 --save-interval 1000 --ephemeral-interval 500 \
    --learning_rate 1e-12 --global-batch-tokens 16384 --no-remote-shell
############################################################################

