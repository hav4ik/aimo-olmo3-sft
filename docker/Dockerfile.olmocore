# Vast.AI / ABCI(NII) deploy image for OLMo-core SFT.
# Thin layer on our prebuilt base (AI2's deps + olmo_core source + FA2 sm90;100;120 + FA3 + FA4).
# Bakes ONLY stable infra: the bootstrap launcher + the nvrtc/TE linker fix. The CODE is cloned at
# runtime (single source of truth = the git ref); the tokenized DATA is downloaded from HF at runtime
# (tokenized OFFLINE, hosted as a dataset repo). No code, no secrets, no data, no tokenizer stack.
# Build context = repo root:
#   docker build -f docker/Dockerfile.olmocore -t hav4ik/olmo3-olmocore:cu130 .
ARG BASE=olmo-core-sft:cu130
FROM ${BASE}

# Bake the nvrtc/TE fix into the linker cache at BUILD time so `import transformer_engine` works
# even on a READ-ONLY rootfs (Singularity squashfs), where run.sh's runtime ld fix can't write.
# cu13 wheels ship libnvrtc under .../nvidia/cu13/lib, off the default linker path; TE greps
# `ldconfig -p` at import and dies if it's missing. Populate + verify the cache here.
RUN set -e; d="$(dirname "$(find /opt/conda -name 'libnvrtc.so*' | head -1)")"; \
    echo "$d" > /etc/ld.so.conf.d/zz-nvrtc.conf && ldconfig && ldconfig -p | grep -q 'libnvrtc\.so'

# The base pins torch==2.10.0 but left torchvision/torchaudio unpinned, so pip pulled torchaudio
# 2.11.0 (built against torch 2.11) -> its libtorchaudio.abi3.so has an undefined symbol
# (torch_dtype_float4_e2m1fn_x2) and fails to load. transformers 5.x imports torchaudio while loading
# the olmo3 model (RNNT loss path), which crashed the HF->distcp convert. torchaudio is unused for LLM
# convert/training and transformers guards its absence, so remove the mismatched wheel.
RUN pip uninstall -y torchaudio >/dev/null 2>&1 || true

COPY bootstrap.sh /usr/local/bin/bootstrap.sh
# train.py: single-command CLI front-end (argparse --flags -> run env -> exec bootstrap). Lets you
# `docker run … python /usr/local/bin/train.py --ac-budget 0.1 --dataset … --seq-len …` without the
# host-side launcher or a pile of -e vars. In-container twin of olmocore/launch.sh.
COPY train.py /usr/local/bin/train.py
RUN chmod +x /usr/local/bin/bootstrap.sh /usr/local/bin/train.py && (command -v git >/dev/null || (apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*))

# Context-parallel (ring) attention dependency. OLMo-core's FA2 backend requires ring-flash-attn for
# CP — our DEFAULT path (cp=4 auto-engages at seq 65536). It's a pure-Python wrapper over the baked
# flash_attn, so no compile. We ALSO shim a transformers-5.x symbol move
# (is_flash_attn_greater_or_equal_2_10 moved to transformers.utils) that ring_flash_attn's hf adapter
# still imports from the old path — without it `import ring_flash_attn` raises ImportError, olmo-core's
# try/except swallows it, and CP dies with "requires the ring-flash-attn package". Build-time import
# check fails the build if either piece is wrong. (Same recipe baked into the axolotl image.)
RUN pip install --no-cache-dir "ring-flash-attn>=0.1.7" \
 && F="$(python -c 'import transformers.modeling_flash_attention_utils as m; print(m.__file__)')" \
 && echo "from transformers.utils import is_flash_attn_greater_or_equal_2_10  # shim: ring_flash_attn hf_adapter on transformers 5.x" >> "$F" \
 && python -c "import ring_flash_attn; print('ring-flash-attn OK')"

# bitsandbytes: 8-bit paged AdamW optimizer (OLMO_OPTIM=adamw8bit / --optim adamw8bit) — stores Adam
# moments in 8-bit, ~24 GB/rank less than fp32 AdamW, for fitting 32B long-context on smaller cards.
# Optional at runtime (default optimizer is fused AdamW). NOTE: bnb's CUDA kernel arch coverage for very
# new GPUs (e.g. RTX 6000 Blackwell sm_120) depends on the build — verify on the target GPU. Import check
# is non-fatal here (no GPU at build time).
RUN pip install --no-cache-dir bitsandbytes \
 && (python -c "import bitsandbytes as b; print('bitsandbytes', b.__version__)" \
     || echo "[bnb] build-time import check skipped (no GPU); verify at runtime")

# Hard CUDA ceiling for the cu128 build: fail the build if ANY installed package pulls CUDA > 12.8
# (a 12.9 or 13.0 transitive dep). Gated by build-arg so the cu130 production build is unaffected
# (default empty = skip). The cu128 chain passes VERIFY_CUDA_MAX=12.8 (see build_cu128_fa2_sink.sh).
ARG VERIFY_CUDA_MAX=
COPY docker/verify_cuda_max.py /usr/local/bin/verify_cuda_max.py
RUN if [ -n "${VERIFY_CUDA_MAX}" ]; then \
        echo "[verify] enforcing CUDA <= ${VERIFY_CUDA_MAX}"; \
        python /usr/local/bin/verify_cuda_max.py --max "${VERIFY_CUDA_MAX}"; \
    else echo "[verify] VERIFY_CUDA_MAX unset — skipping CUDA ceiling check"; fi

# Code is cloned into the mounted run storage at runtime (single source = the git ref); pin a run
# with CODE_REF=<branch|tag|commit>. CODE_DIR must live on a writable mount (the bound /data/training).
# CODE_BRANCH is the fallback ref when CODE_REF is unset. This is the fa2-sink image, so it MUST
# default to the sink working branch — the old olmo3-sft branch has NONE of the sink/CP/optim work
# (no smem guard, no Ulysses intra-doc RoPE fix, no sink read/train/export) and a run on it silently
# regresses. train.py already passes --code-ref; this default covers a bare-entrypoint launch.
ENV CODE_REPO=https://github.com/hav4ik/aimo-olmo3-sft \
    CODE_BRANCH=olmocore-cu128-fa2-sink \
    CODE_DIR=/data/training/code \
    HF_HOME=/data/training/hf_cache \
    SFT_FRAMEWORK=olmocore
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/bootstrap.sh"]
