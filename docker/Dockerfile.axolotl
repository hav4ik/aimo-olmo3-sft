# Vast.AI / cluster deploy image for Axolotl SFT.
# Thin layer on our prebuilt axolotl base (official axolotl-uv cu130 + FA3 wheel + NCCL env).
# Bakes ONLY the bootstrap (clones the code repo at runtime). No code, no secrets, no data.
# Build context = repo root:  docker build -f docker/Dockerfile.axolotl -t hav4ik/olmo3-axolotl:cu130 .
ARG BASE=axolotl-olmo3-sft:0.1.0
FROM ${BASE}

USER root
COPY bootstrap.sh /usr/local/bin/bootstrap.sh
RUN chmod +x /usr/local/bin/bootstrap.sh && (command -v git >/dev/null || (apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*))

# Sequence-parallelism deps for long-context (65536). Reuse the FA2 (sm90;100;120) already built in
# the olmo-core base (same torch 2.10/cu130 + py3.12 => ABI matches) instead of recompiling; add
# ring-flash-attn; and shim a transformers-5.x symbol move that ring-flash-attn's hf_adapter still
# imports from the old path. axolotl SP accepts attn_implementation flash_attention_2 OR _3, but the
# ring kernel is FA2-based and FA3 is Hopper-only, so FA2 is required either way (run.sh forces
# flash_attention_2 when context_parallel_size>1). Requires the olmo-core image built first.
COPY --from=chankhavu/olmo3-olmocore:cu130 /opt/conda/lib/python3.12/site-packages/flash_attn /workspace/axolotl-venv/lib/python3.12/site-packages/flash_attn
COPY --from=chankhavu/olmo3-olmocore:cu130 /opt/conda/lib/python3.12/site-packages/flash_attn-2.8.2.dist-info /workspace/axolotl-venv/lib/python3.12/site-packages/flash_attn-2.8.2.dist-info
COPY --from=chankhavu/olmo3-olmocore:cu130 /opt/conda/lib/python3.12/site-packages/flash_attn_2_cuda.cpython-312-x86_64-linux-gnu.so /workspace/axolotl-venv/lib/python3.12/site-packages/
RUN . /workspace/axolotl-venv/bin/activate \
 && uv pip install "ring-flash-attn>=0.1.7" \
 && F="$(python -c 'import transformers.modeling_flash_attention_utils as m; print(m.__file__)')" \
 && echo "from transformers.utils import is_flash_attn_greater_or_equal_2_10  # shim: ring_flash_attn hf_adapter on transformers 5.x" >> "$F"

# Code is cloned into the mounted run storage at runtime (single source = the git ref); pin with
# CODE_REF=<branch|tag|commit>. CODE_DIR must live on a writable mount (the bound /data/training).
ENV CODE_REPO=https://github.com/hav4ik/aimo-olmo3-sft \
    CODE_BRANCH=olmo3-sft \
    CODE_DIR=/data/training/code \
    HF_HOME=/data/training/hf_cache
WORKDIR /workspace
# Override the base image's uv-entrypoint; axolotl/run.sh sources the venv itself.
ENTRYPOINT ["/usr/local/bin/bootstrap.sh"]
